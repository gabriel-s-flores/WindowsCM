<Window x:Class="PopupProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PROTOTYPE — WindowsCM popup (throwaway)"
        Width="900" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <Border x:Name="RootBorder" Margin="10" CornerRadius="12" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
    </Border.Effect>
    <DockPanel Margin="12">
      <!-- Shared Copyous-like header -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
        <Button x:Name="SettingsBtn" DockPanel.Dock="Left" Content="⚙" Width="36" Height="36" Margin="0,0,6,0" Click="SettingsBtn_Click"/>
        <ToggleButton x:Name="IncognitoBtn" DockPanel.Dock="Left" Content="🕶" Width="36" Height="36" Margin="0,0,6,0" Checked="Incognito_Changed" Unchecked="Incognito_Changed"/>
        <Button x:Name="ClearBtn" DockPanel.Dock="Right" Content="Clear" Height="36" Padding="14,0" Margin="6,0,0,0" Click="ClearBtn_Click"/>
        <ToggleButton x:Name="PinFilterBtn" DockPanel.Dock="Right" Content="📌" Width="36" Height="36" Margin="6,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        <Border x:Name="SearchBorder" CornerRadius="18" BorderThickness="1" Padding="12,0">
          <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                   VerticalContentAlignment="Center" FontSize="14"
                   TextChanged="SearchBox_TextChanged"/>
        </Border>
      </DockPanel>
      <!-- Prototype switcher (NOT part of the design being evaluated) -->
      <Border DockPanel.Dock="Bottom" x:Name="SwitcherBorder" CornerRadius="10" BorderThickness="1" Margin="0,10,0,6" Padding="8,6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="◀" Click="PrevVariant_Click" Margin="0,0,8,0" Padding="8,2"/>
          <Button Content="A · Cards" Click="VariantA_Click" Margin="0,0,4,0" Padding="8,2"/>
          <Button Content="B · List" Click="VariantB_Click" Margin="0,0,4,0" Padding="8,2"/>
          <Button Content="C · Palette" Click="VariantC_Click" Margin="0,0,8,0" Padding="8,2"/>
          <Button Content="▶" Click="NextVariant_Click" Margin="0,0,12,0" Padding="8,2"/>
          <TextBlock x:Name="VariantLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="ThemeBtn" Content="Theme: Dark" Click="ThemeBtn_Click" Padding="8,2"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
      <!-- Variant containers (exactly one visible; contents built in code) -->
      <Grid>
        <ScrollViewer x:Name="ScrollA" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Visible">
          <StackPanel x:Name="CardsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </ScrollViewer>
        <ScrollViewer x:Name="ScrollB" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="RowsPanelB"/>
        </ScrollViewer>
        <ScrollViewer x:Name="ScrollC" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="RowsPanelC"/>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
