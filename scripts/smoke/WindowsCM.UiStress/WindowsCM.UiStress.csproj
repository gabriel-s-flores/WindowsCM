<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/WindowsCM.App/WindowsCM.App.csproj" />
    <!-- Relative icon URIs resolve against the harness entry assembly. -->
    <Resource Include="../../../src/WindowsCM.App/Assets/app.ico" Link="Assets/app.ico" />
  </ItemGroup>
</Project>
