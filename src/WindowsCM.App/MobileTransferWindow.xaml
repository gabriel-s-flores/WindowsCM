<Window x:Class="WindowsCM.App.MobileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_MobileWindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="430" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource PopupBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

  <Window.Resources>
    <Style x:Key="FluentPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource CardAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CardAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FluentOutlineButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
        <TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="22" Foreground="{DynamicResource CardAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{DynamicResource Loc_MobileHeaderTitle}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{DynamicResource Loc_MobileHeaderSubtitle}"
                 FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                 HorizontalAlignment="Center" TextAlignment="Center" />
    </StackPanel>

    <!-- Center QR Code & Connection -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Border Background="#FFFFFF" CornerRadius="16" Padding="14" HorizontalAlignment="Center" Margin="0,0,0,12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" Color="#000000" />
        </Border.Effect>
        <Image x:Name="QrImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border>

      <!-- URL link & Copy -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock x:Name="UrlText" Text="http://192.168.1.8:58921/"
                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Content="{DynamicResource Loc_MobileCopyLinkButton}" Style="{StaticResource FluentOutlineButton}"
                Click="OnCopyUrlClicked" />
      </StackPanel>

      <!-- Status Card -->
      <Border x:Name="StatusCard" Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12,10" Width="360" HorizontalAlignment="Center">
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusDot" Text="●" Foreground="#28A745" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="StatusText" Text="{DynamicResource Loc_MobileStatusActive}"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="StatusSubtext" Text="{DynamicResource Loc_MobileStatusSubtext}"
                     FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                     TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Footer Actions -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="{DynamicResource Loc_MobileOpenFolderButton}"
              Style="{StaticResource FluentOutlineButton}" HorizontalAlignment="Left"
              Click="OnOpenFolderClicked" />

      <Button Grid.Column="1" Content="{DynamicResource Loc_MobileCloseButton}"
              Style="{StaticResource FluentPrimaryButton}" Width="90"
              Click="OnCloseClicked" />
    </Grid>
  </Grid>
</Window>
