<Window x:Class="WindowsCM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsCM Settings" Width="560" Height="620"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="Hotkeys" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Open history"
                   VerticalAlignment="Center" />
        <TextBox x:Name="OpenGestureBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />
        <Button Grid.Row="0" Grid.Column="2" Content="Apply" Margin="6,2,0,2"
                Padding="12,2" Click="OnApplyOpenGesture" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Incognito history"
                   VerticalAlignment="Center" />
        <TextBox x:Name="IncognitoGestureBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
        <Button Grid.Row="1" Grid.Column="2" Content="Apply" Margin="6,2,0,2"
                Padding="12,2" Click="OnApplyIncognitoGesture" />
      </Grid>
      <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Foreground="Gray"
                 FontSize="11" Margin="0,0,0,16" />

      <TextBlock Text="Startup" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <CheckBox x:Name="AutostartCheck" Content="Start WindowsCM on login (tray-only)"
                Margin="0,0,0,16" Checked="OnAutostartChanged"
                Unchecked="OnAutostartChanged" />

      <TextBlock Text="System Tray" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <TextBlock x:Name="TrayGuidanceText" TextWrapping="Wrap" Foreground="Gray"
                 FontSize="11" Margin="0,0,0,16" />

      <TextBlock Text="Folders" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <Button Content="Open data folder" Margin="0,0,6,0" Padding="8,2"
                Click="OnOpenData" />
        <Button Content="Open config folder" Margin="0,0,6,0" Padding="8,2"
                Click="OnOpenConfig" />
        <Button Content="Open cache folder" Padding="8,2" Click="OnOpenCache" />
      </StackPanel>
      <TextBlock x:Name="PathsText" TextWrapping="Wrap" Foreground="Gray"
                 FontSize="11" Margin="0,0,0,16" />

      <TextBlock Text="Versions" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <TextBlock x:Name="VersionsText" TextWrapping="Wrap" FontFamily="Consolas"
                 FontSize="11" Margin="0,0,0,16" />

      <TextBlock Text="Credits" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
      <TextBlock x:Name="CreditsText" TextWrapping="Wrap" FontSize="11" />
    </StackPanel>
  </ScrollViewer>
</Window>
