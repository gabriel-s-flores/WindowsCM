<Window x:Class="WindowsCM.App.SubtleToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
  <Border x:Name="ToastBorder" Background="#2B2B2B"
          BorderBrush="#444444" BorderThickness="1"
          CornerRadius="18" Padding="14,8" Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="20" Height="20" CornerRadius="10" Background="#1B4D3E" Margin="0,0,8,0"
              VerticalAlignment="Center">
        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="11" Foreground="#6CCB5F" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock x:Name="ToastText" Text="{DynamicResource Loc_ToastAddedToClipboard}"
                 FontSize="12" Foreground="#EDEDED" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,4,0" />
    </StackPanel>
  </Border>
</Window>
