<Window x:Class="WindowsCM.App.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_QrWindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource PopupBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

  <Window.Resources>
    <Style x:Key="FluentPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource CardAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FluentOutlineButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header / Item Info -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
      <TextBlock x:Name="HeaderTitle" Text="{DynamicResource Loc_QrHeaderScanTitle}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock x:Name="HeaderSubtitle" Text="{DynamicResource Loc_QrHeaderScanSubtitle}"
                 FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
      
      <!-- File metadata pill (visible when sharing a file) -->
      <Border x:Name="FileMetaBorder" Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="FileIconGlyph" Text="&#xED43;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="12" Foreground="{DynamicResource CardAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock x:Name="FileNameText" Text="arquivo.ext" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
          <TextBlock x:Name="FileSizeText" Text=" • 2.4 MB" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Center: QR Code Image -->
    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" Padding="12"
            HorizontalAlignment="Center" Margin="0,0,0,12">
      <Border.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000" />
      </Border.Effect>
      <Image x:Name="QrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Border>

    <!-- URL / Payload row -->
    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock x:Name="PayloadText" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                 HorizontalAlignment="Center" Margin="0,0,0,6" />
      <Button x:Name="CopyLinkButton" Content="{DynamicResource Loc_QrCopyAccessLink}"
              Style="{StaticResource FluentOutlineButton}" HorizontalAlignment="Center"
              Visibility="Collapsed" Click="OnCopyLinkClicked" />
    </StackPanel>

    <!-- Bottom Actions -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="PickAnotherFileButton" Grid.Column="0" Content="{DynamicResource Loc_QrPickAnotherFile}"
              Style="{StaticResource FluentOutlineButton}" HorizontalAlignment="Left"
              Click="OnPickAnotherFileClicked" />

      <Button Grid.Column="1" Content="{DynamicResource Loc_QrCloseButton}"
              Style="{StaticResource FluentPrimaryButton}" Width="80"
              Click="OnCloseClicked" />
    </Grid>
  </Grid>
</Window>
