<Window x:Class="WindowsCM.App.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Código QR" Width="300" Height="330"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="12">
    <Image x:Name="QrImage" Width="260" Height="260" />
    <TextBlock x:Name="PayloadText" TextTrimming="CharacterEllipsis"
               Foreground="Gray" FontSize="11" Margin="0,8,0,0" />
  </StackPanel>
</Window>
