<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WindowsCM</AssemblyName>
    <RootNamespace>WindowsCM.App</RootNamespace>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Single-file publish leaves native libs (e_sqlite3, wpfgfx_cor3,
         PresentationNative_cor3, ...) beside the exe unless bundled. The
         installer ships only WindowsCM.exe, so without this the installed
         app dies silently at startup. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

  <!-- A tray app lives for days: have the GC compact the large-object heap
       and hand memory back sooner. Measured by the app smoke over 600
       copies: working set 386 -> 281 MB, private bytes after a full GC
       ~270 -> ~170 MB, popup latency unchanged (p50 66 ms). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\WindowsCM.Core\WindowsCM.Core.csproj" />
  </ItemGroup>

</Project>
